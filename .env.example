# Canonical production URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.velto.com.bd

# Optional browser-side analytics entry point. Configure GA4 and Meta Pixel
# inside this GTM container to avoid duplicate browser tags.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Server-only Velto Ops / Supabase pricing connection.
# Do not prefix either value with NEXT_PUBLIC_.
VELTO_SUPABASE_URL=https://your-project.supabase.co
VELTO_SUPABASE_SECRET_KEY=sb_secret_replace_me

# Dedicated signing secret for /admin sessions. Required in production so admin
# cookies do not depend on the Supabase service credential fallback. Generate a
# long random value and keep it server-only.
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Name of the approved, public-safe view exposed through the Supabase Data API.
# The default contract is documented in docs/technical/INTEGRATIONS.md.
VELTO_PRICING_VIEW=website_pricing_public

# Website bookings/quotes are written into Velto Ops only when this is "true".
# Enable it only when VELTO_SUPABASE_URL points at the production Ops project
# and docs/technical/sql/website_create_request.sql has been applied there.
VELTO_OPS_WRITES_ENABLED=false
# Set to true only after website_revenue_attribution.sql and the new website_create_request.sql are
# applied to the Ops database. Until then the analytics session id and raw ad click ids are stripped
# from bookings/quotes so the legacy intake never writes them into staff-visible task text.
VELTO_ATTRIBUTION_SQL_LIVE=false

# Customer accounts (Customer Portal V1). Off unless "true". Enable only after
# docs/technical/sql/customer_portal.sql has been applied to the project in
# VELTO_SUPABASE_URL (it hardens Ops access before customers can sign up).
# The publishable (anon) key is used from the server only; never prefix it with NEXT_PUBLIC_.
VELTO_CUSTOMER_ACCOUNTS_ENABLED=false
VELTO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Live Google reviews (Places API New). Server only; leave empty to show verified reviews only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID_SECTOR_11=
GOOGLE_PLACE_ID_SECTOR_18=
