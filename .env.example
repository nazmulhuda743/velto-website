# Server-only Velto Ops / Supabase pricing connection.
# Do not prefix either value with NEXT_PUBLIC_.
VELTO_SUPABASE_URL=https://your-project.supabase.co
VELTO_SUPABASE_SECRET_KEY=sb_secret_replace_me

# Name of the approved, public-safe view exposed through the Supabase Data API.
# The default contract is documented in docs/technical/INTEGRATIONS.md.
VELTO_PRICING_VIEW=website_pricing_public
